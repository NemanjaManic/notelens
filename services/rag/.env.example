# Copy to .env in this directory. Never commit .env or paste keys into chat.
OPENAI_API_KEY=
NOTELENS_RAG_EMBEDDING_MODEL=text-embedding-3-small
NOTELENS_RAG_EMBEDDING_DIMENSIONS=1536
# A key alone never authorizes paid execution. Keep false until approval.
NOTELENS_RAG_ALLOW_PAID_EMBEDDINGS=false
# Separate assessment gate; also needs the reviewed trial's explicit approval and budget.
NOTELENS_RAG_ALLOW_PAID_ASSESSMENTS=false
