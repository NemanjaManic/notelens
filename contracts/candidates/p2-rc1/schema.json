{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:notelens:contracts:candidates:p2-rc1",
  "title": "NoteLens P2 RC1 review candidate",
  "$comment": "REVIEW ONLY. P1 remains canonical; no owner approval, freeze, or activation is asserted.",
  "$defs": {
    "EvidenceSpan": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "PreparedDocument": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "canonicalization_version": {
          "const": "nfc-lf-v1"
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "builtin_public",
                "public_text",
                "synthetic_text",
                "text_pdf"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "language": {
          "const": "en"
        },
        "language_validation": {
          "$ref": "#/$defs/LanguageValidation"
        }
      },
      "required": [
        "schema_version",
        "doc_id",
        "text_sha256",
        "text",
        "canonicalization_version",
        "source",
        "language",
        "language_validation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "language_validation": {
              "properties": {
                "outcome": {
                  "const": "accepted"
                }
              }
            }
          }
        }
      ]
    },
    "ClassificationScore": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "Cardiovascular / Pulmonary",
            "Orthopedic",
            "Gastroenterology",
            "Neurology",
            "Urology"
          ]
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "category",
        "score"
      ],
      "additionalProperties": false
    },
    "ClassificationResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "uncertain",
            "unsupported"
          ]
        },
        "category": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "Cardiovascular / Pulmonary",
                "Orthopedic",
                "Gastroenterology",
                "Neurology",
                "Urology"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClassificationScore"
          }
        },
        "score_kind": {
          "anyOf": [
            {
              "enum": [
                "probability",
                "decision_score"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence_note": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "classification_execution": {
          "enum": [
            "skipped",
            "performed"
          ]
        },
        "scope_policy_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_reason": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "mode",
        "doc_id",
        "text_sha256",
        "status",
        "category",
        "scores",
        "score_kind",
        "confidence_note",
        "model_version",
        "classification_execution",
        "scope_policy_version",
        "scope_reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "category": {
                "enum": [
                  "Cardiovascular / Pulmonary",
                  "Orthopedic",
                  "Gastroenterology",
                  "Neurology",
                  "Urology"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "uncertain",
                  "unsupported"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "category": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification_execution": {
                "const": "performed"
              }
            },
            "required": [
              "classification_execution"
            ]
          },
          "then": {
            "properties": {
              "model_version": {
                "type": "string",
                "minLength": 1
              },
              "score_kind": {
                "enum": [
                  "probability",
                  "decision_score"
                ]
              },
              "scores": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification_execution": {
                "const": "skipped"
              }
            },
            "required": [
              "classification_execution"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "unsupported"
              },
              "model_version": {
                "const": null
              },
              "score_kind": {
                "const": null
              },
              "scores": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unsupported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "scope_policy_version": {
                "type": "string",
                "minLength": 1
              },
              "scope_reason": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "supported",
                  "uncertain"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "classification_execution": {
                "const": "performed"
              },
              "scope_policy_version": {
                "const": null
              },
              "scope_reason": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score_kind": {
                "const": "probability"
              }
            },
            "required": [
              "score_kind"
            ]
          },
          "then": {
            "properties": {
              "scores": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/ClassificationScore"
                    },
                    {
                      "properties": {
                        "score": {
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "DocumentSource": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "document"
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceSpan"
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "kind",
        "doc_id",
        "text_sha256",
        "evidence",
        "component_id"
      ],
      "additionalProperties": false
    },
    "LiteratureSource": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "literature"
        },
        "topic_id": {
          "type": "string",
          "minLength": 1
        },
        "passage_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_date": {
          "type": "string",
          "format": "date"
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "kind",
        "topic_id",
        "passage_id",
        "title",
        "url",
        "text",
        "snapshot_date",
        "component_id"
      ],
      "additionalProperties": false
    },
    "Source": {
      "oneOf": [
        {
          "$ref": "#/$defs/DocumentSource"
        },
        {
          "$ref": "#/$defs/LiteratureSource"
        }
      ]
    },
    "Claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "document_fact",
            "general_information"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "claim_id",
        "text",
        "scope",
        "source_ids",
        "component_id"
      ],
      "additionalProperties": false
    },
    "Summary": {
      "type": "object",
      "properties": {
        "language": {
          "const": "en"
        },
        "text": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentSource"
          }
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "sufficient",
            "partial",
            "insufficient"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentProvenance"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "language",
        "text",
        "claims",
        "sources",
        "evidence_state",
        "warnings",
        "provenance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "sufficient"
              }
            }
          },
          "then": {
            "properties": {
              "claims": {
                "minItems": 1
              },
              "sources": {
                "minItems": 1
              },
              "text": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_state": {
                "enum": [
                  "sufficient",
                  "partial"
                ]
              }
            },
            "required": [
              "evidence_state"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "$ref": "#/$defs/ComponentProvenance"
              }
            }
          }
        }
      ]
    },
    "ExtractionItem": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "diagnosis",
            "symptom",
            "procedure"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "assertion": {
          "type": "string",
          "enum": [
            "confirmed",
            "suspected",
            "negated",
            "unknown"
          ]
        },
        "temporality": {
          "type": "string",
          "enum": [
            "current",
            "historical",
            "unknown"
          ]
        },
        "subject": {
          "type": "string",
          "enum": [
            "patient",
            "family",
            "other",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1
        },
        "icd": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "$ref": "#/$defs/EvidenceSpan"
            }
          },
          "required": [
            "code",
            "evidence"
          ],
          "additionalProperties": false
        },
        "mention": {
          "$ref": "#/$defs/EvidenceSpan"
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "procedure_status": {
          "enum": [
            null,
            "planned",
            "ordered",
            "performed",
            "cancelled",
            "hypothetical",
            "unknown"
          ]
        }
      },
      "required": [
        "entity_id",
        "type",
        "name",
        "assertion",
        "temporality",
        "subject",
        "evidence",
        "mention",
        "component_id",
        "procedure_status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "procedure"
              }
            }
          },
          "then": {
            "properties": {
              "procedure_status": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "procedure_status": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "ExtractionResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "enum": [
            "mock",
            "live",
            "mixed"
          ]
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExtractionItem"
          }
        },
        "summary": {
          "$ref": "#/$defs/SummaryOutcome"
        },
        "extractor_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction_status": {
          "enum": [
            "completed",
            "partial",
            "failed"
          ]
        },
        "extraction_error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "extraction_provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentProvenance"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "mode",
        "doc_id",
        "text_sha256",
        "items",
        "summary",
        "extractor_version",
        "prompt_version",
        "extraction_status",
        "extraction_error",
        "warnings",
        "extraction_provenance"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "extraction_status": {
                "const": "failed"
              }
            },
            "required": [
              "extraction_status"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "maxItems": 0
              },
              "extraction_error": {
                "$ref": "#/$defs/ErrorDetail"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "extraction_status": {
                "const": "completed"
              }
            },
            "required": [
              "extraction_status"
            ]
          },
          "then": {
            "properties": {
              "extraction_error": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "extraction_status": {
                "const": "partial"
              }
            },
            "required": [
              "extraction_status"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              },
              "warnings": {
                "minItems": 1
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "extraction_status": {
                "const": "failed"
              },
              "summary": {
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                }
              }
            },
            "required": [
              "extraction_status",
              "summary"
            ]
          }
        }
      ]
    },
    "RetrievalRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "specialty_hint": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "Cardiovascular / Pulmonary",
                "Orthopedic",
                "Gastroenterology",
                "Neurology",
                "Urology"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "question"
      ],
      "additionalProperties": false
    },
    "RetrievalPassage": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "literature"
        },
        "topic_id": {
          "type": "string",
          "minLength": 1
        },
        "passage_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_date": {
          "type": "string",
          "format": "date"
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "source_id",
        "kind",
        "topic_id",
        "passage_id",
        "title",
        "url",
        "text",
        "snapshot_date",
        "score"
      ],
      "additionalProperties": false
    },
    "RetrievalResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "sufficient",
            "insufficient"
          ]
        },
        "passages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetrievalPassage"
          }
        },
        "retriever_version": {
          "type": "string",
          "minLength": 1
        },
        "index_version": {
          "type": "string",
          "minLength": 1
        },
        "score_note": {
          "type": "string",
          "minLength": 1
        },
        "corpus_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "mode",
        "state",
        "passages",
        "retriever_version",
        "index_version",
        "score_note",
        "corpus_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "sufficient"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "passages": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "AnswerResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "enum": [
            "mock",
            "live",
            "mixed"
          ]
        },
        "language": {
          "const": "en"
        },
        "text": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "sufficient",
            "partial",
            "insufficient"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route": {
          "type": "string",
          "enum": [
            "document",
            "literature",
            "mixed",
            "none"
          ]
        },
        "answer_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentProvenance"
          }
        },
        "attempted_routes": {
          "type": "array",
          "items": {
            "enum": [
              "document",
              "literature"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "clarification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Clarification"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "mode",
        "language",
        "text",
        "claims",
        "sources",
        "evidence_state",
        "warnings",
        "route",
        "answer_version",
        "prompt_version",
        "components",
        "attempted_routes",
        "clarification"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "sufficient"
              }
            }
          },
          "then": {
            "properties": {
              "claims": {
                "minItems": 1
              },
              "sources": {
                "minItems": 1
              },
              "text": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_state": {
                "const": "insufficient"
              },
              "claims": {
                "maxItems": 0
              },
              "sources": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "document"
              }
            }
          },
          "then": {
            "properties": {
              "sources": {
                "items": {
                  "$ref": "#/$defs/DocumentSource"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "literature"
              }
            }
          },
          "then": {
            "properties": {
              "sources": {
                "items": {
                  "$ref": "#/$defs/LiteratureSource"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "mixed"
              },
              "evidence_state": {
                "const": "sufficient"
              }
            }
          },
          "then": {
            "properties": {
              "sources": {
                "allOf": [
                  {
                    "contains": {
                      "$ref": "#/$defs/DocumentSource"
                    }
                  },
                  {
                    "contains": {
                      "$ref": "#/$defs/LiteratureSource"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "clarification": {
                "type": "object"
              }
            },
            "required": [
              "clarification"
            ]
          },
          "then": {
            "properties": {
              "route": {
                "const": "none"
              },
              "evidence_state": {
                "const": "insufficient"
              },
              "claims": {
                "maxItems": 0
              },
              "sources": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "mixed"
              }
            },
            "required": [
              "route"
            ]
          },
          "then": {
            "properties": {
              "attempted_routes": {
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "ClassificationRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "document": {
          "$ref": "#/$defs/PreparedDocument"
        }
      },
      "required": [
        "schema_version",
        "document"
      ],
      "additionalProperties": false
    },
    "ExtractionRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "document": {
          "$ref": "#/$defs/PreparedDocument"
        }
      },
      "required": [
        "schema_version",
        "document"
      ],
      "additionalProperties": false
    },
    "DocumentQuestionRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "document": {
          "$ref": "#/$defs/PreparedDocument"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "document",
        "question"
      ],
      "additionalProperties": false
    },
    "LiteratureAnswerRequest": {
      "$ref": "#/$defs/RetrievalRequest"
    },
    "ErrorDetail": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "unsupported_file",
            "unsupported_language",
            "validation_failure",
            "timeout",
            "rate_limit",
            "provider_unavailable",
            "insufficient_evidence",
            "document_unavailable",
            "unauthorized",
            "configuration_required",
            "budget_exceeded",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "$ref": "#/$defs/RequestId"
        },
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    },
    "HealthResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "service": {
          "type": "string",
          "enum": [
            "rag",
            "classifier",
            "extraction"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "not_ready"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "service",
        "status",
        "mode",
        "version",
        "model_version",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_ready"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "mock"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "model_version": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "live"
              },
              "service": {
                "const": "classifier"
              },
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "mode",
              "service",
              "status"
            ]
          },
          "then": {
            "properties": {
              "model_version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "RequestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "LanguageValidation": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "accepted",
            "rejected",
            "inconclusive"
          ]
        },
        "language": {
          "anyOf": [
            {
              "const": "en"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "enum": [
            null,
            "unsupported_language",
            "language_inconclusive"
          ]
        }
      },
      "required": [
        "outcome",
        "language",
        "policy_version",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "accepted"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "language": {
                "const": "en"
              },
              "reason": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "rejected"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "language": {
                "const": null
              },
              "reason": {
                "const": "unsupported_language"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "inconclusive"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "language": {
                "const": null
              },
              "reason": {
                "const": "language_inconclusive"
              }
            }
          }
        }
      ]
    },
    "ComponentProvenance": {
      "type": "object",
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "enum": [
            "rag",
            "extraction"
          ]
        },
        "operation": {
          "enum": [
            "extract",
            "summarize",
            "document-answer",
            "literature-answer"
          ]
        },
        "mode": {
          "enum": [
            "mock",
            "live"
          ]
        },
        "output_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "configuration_version": {
          "type": "string",
          "minLength": 1
        },
        "corpus_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "index_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "retriever_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "component_id",
        "service",
        "operation",
        "mode",
        "output_version",
        "prompt_version",
        "provider",
        "model",
        "configuration_version",
        "corpus_version",
        "index_version",
        "retriever_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "service": {
                "const": "rag"
              }
            },
            "required": [
              "service"
            ]
          },
          "then": {
            "properties": {
              "operation": {
                "const": "literature-answer"
              },
              "corpus_version": {
                "type": "string",
                "minLength": 1
              },
              "index_version": {
                "type": "string",
                "minLength": 1
              },
              "retriever_version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "service": {
                "const": "extraction"
              }
            },
            "required": [
              "service"
            ]
          },
          "then": {
            "properties": {
              "operation": {
                "enum": [
                  "extract",
                  "summarize",
                  "document-answer"
                ]
              },
              "corpus_version": {
                "const": null
              },
              "index_version": {
                "const": null
              },
              "retriever_version": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "SummaryOutcome": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/Summary"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorDetail"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "result",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/Summary"
              },
              "error": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "const": null
              },
              "error": {
                "$ref": "#/$defs/ErrorDetail"
              }
            }
          }
        }
      ]
    },
    "Clarification": {
      "type": "object",
      "properties": {
        "code": {
          "const": "ambiguous_reference"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "LivenessResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "service": {
          "enum": [
            "rag",
            "classifier",
            "extraction"
          ]
        },
        "status": {
          "const": "alive"
        },
        "mode": {
          "enum": [
            "mock",
            "live"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "service",
        "status",
        "mode",
        "version"
      ],
      "additionalProperties": false
    }
  }
}
