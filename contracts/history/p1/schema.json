{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:notelens:contracts:v1",
  "title": "NoteLens v1 contract proposal",
  "$comment": "DRAFT FOR A/B/C/D REVIEW. No contract freeze or implementation acceptance is implied.",
  "$defs": {
    "EvidenceSpan": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "PreparedDocument": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "canonicalization_version": {
          "const": "nfc-lf-v1"
        },
        "source": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "builtin_public",
                "public_text",
                "synthetic_text",
                "text_pdf"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "language": {
          "const": "en"
        }
      },
      "required": [
        "schema_version",
        "doc_id",
        "text_sha256",
        "text",
        "canonicalization_version",
        "source",
        "language"
      ],
      "additionalProperties": false
    },
    "ClassificationScore": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "Cardiovascular / Pulmonary",
            "Orthopedic",
            "Gastroenterology",
            "Neurology",
            "Urology"
          ]
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "category",
        "score"
      ],
      "additionalProperties": false
    },
    "ClassificationResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "uncertain",
            "unsupported"
          ]
        },
        "category": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "Cardiovascular / Pulmonary",
                "Orthopedic",
                "Gastroenterology",
                "Neurology",
                "Urology"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClassificationScore"
          }
        },
        "score_kind": {
          "type": "string",
          "enum": [
            "probability",
            "decision_score"
          ]
        },
        "confidence_note": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "mode",
        "doc_id",
        "text_sha256",
        "status",
        "category",
        "scores",
        "score_kind",
        "confidence_note",
        "model_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported"
              }
            }
          },
          "then": {
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "Cardiovascular / Pulmonary",
                  "Orthopedic",
                  "Gastroenterology",
                  "Neurology",
                  "Urology"
                ]
              },
              "scores": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          },
          "else": {
            "properties": {
              "category": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "score_kind": {
                "const": "probability"
              }
            }
          },
          "then": {
            "properties": {
              "scores": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/ClassificationScore"
                    },
                    {
                      "properties": {
                        "score": {
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "DocumentSource": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "document"
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceSpan"
        }
      },
      "required": [
        "source_id",
        "kind",
        "doc_id",
        "text_sha256",
        "evidence"
      ],
      "additionalProperties": false
    },
    "LiteratureSource": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "literature"
        },
        "topic_id": {
          "type": "string",
          "minLength": 1
        },
        "passage_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "source_id",
        "kind",
        "topic_id",
        "passage_id",
        "title",
        "url",
        "text",
        "snapshot_date"
      ],
      "additionalProperties": false
    },
    "Source": {
      "oneOf": [
        {
          "$ref": "#/$defs/DocumentSource"
        },
        {
          "$ref": "#/$defs/LiteratureSource"
        }
      ]
    },
    "Claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "document_fact",
            "general_information"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "claim_id",
        "text",
        "scope",
        "source_ids"
      ],
      "additionalProperties": false
    },
    "Summary": {
      "type": "object",
      "properties": {
        "language": {
          "const": "en"
        },
        "text": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentSource"
          }
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "sufficient",
            "partial",
            "insufficient"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "language",
        "text",
        "claims",
        "sources",
        "evidence_state",
        "warnings"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "sufficient"
              }
            }
          },
          "then": {
            "properties": {
              "claims": {
                "minItems": 1
              },
              "sources": {
                "minItems": 1
              },
              "text": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "ExtractionItem": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "diagnosis",
            "symptom",
            "procedure"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "assertion": {
          "type": "string",
          "enum": [
            "confirmed",
            "suspected",
            "negated"
          ]
        },
        "temporality": {
          "type": "string",
          "enum": [
            "current",
            "historical",
            "unknown"
          ]
        },
        "subject": {
          "type": "string",
          "enum": [
            "patient",
            "family",
            "other",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "minItems": 1
        },
        "icd": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "$ref": "#/$defs/EvidenceSpan"
            }
          },
          "required": [
            "code",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "entity_id",
        "type",
        "name",
        "assertion",
        "temporality",
        "subject",
        "evidence"
      ],
      "additionalProperties": false
    },
    "ExtractionResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExtractionItem"
          }
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "extractor_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "mode",
        "doc_id",
        "text_sha256",
        "items",
        "summary",
        "extractor_version",
        "prompt_version"
      ],
      "additionalProperties": false
    },
    "RetrievalRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "specialty_hint": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "Cardiovascular / Pulmonary",
                "Orthopedic",
                "Gastroenterology",
                "Neurology",
                "Urology"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "question"
      ],
      "additionalProperties": false
    },
    "RetrievalPassage": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "literature"
        },
        "topic_id": {
          "type": "string",
          "minLength": 1
        },
        "passage_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_date": {
          "type": "string",
          "format": "date"
        },
        "score": {
          "type": "number"
        }
      },
      "required": [
        "source_id",
        "kind",
        "topic_id",
        "passage_id",
        "title",
        "url",
        "text",
        "snapshot_date",
        "score"
      ],
      "additionalProperties": false
    },
    "RetrievalResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "sufficient",
            "insufficient",
            "error"
          ]
        },
        "passages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RetrievalPassage"
          }
        },
        "retriever_version": {
          "type": "string",
          "minLength": 1
        },
        "index_version": {
          "type": "string",
          "minLength": 1
        },
        "score_note": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "schema_version",
        "mode",
        "state",
        "passages",
        "retriever_version",
        "index_version",
        "score_note"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          },
          "else": {
            "not": {
              "required": [
                "error"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "sufficient"
              }
            }
          },
          "then": {
            "properties": {
              "passages": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "AnswerResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "mode": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "language": {
          "const": "en"
        },
        "text": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "evidence_state": {
          "type": "string",
          "enum": [
            "sufficient",
            "partial",
            "insufficient"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route": {
          "type": "string",
          "enum": [
            "document",
            "literature",
            "mixed",
            "none"
          ]
        },
        "answer_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "mode",
        "language",
        "text",
        "claims",
        "sources",
        "evidence_state",
        "warnings",
        "route",
        "answer_version",
        "prompt_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "sufficient"
              }
            }
          },
          "then": {
            "properties": {
              "claims": {
                "minItems": 1
              },
              "sources": {
                "minItems": 1
              },
              "text": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_state": {
                "const": "insufficient"
              },
              "claims": {
                "maxItems": 0
              },
              "sources": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "document"
              }
            }
          },
          "then": {
            "properties": {
              "sources": {
                "items": {
                  "$ref": "#/$defs/DocumentSource"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "literature"
              }
            }
          },
          "then": {
            "properties": {
              "sources": {
                "items": {
                  "$ref": "#/$defs/LiteratureSource"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "mixed"
              },
              "evidence_state": {
                "const": "sufficient"
              }
            }
          },
          "then": {
            "properties": {
              "sources": {
                "allOf": [
                  {
                    "contains": {
                      "$ref": "#/$defs/DocumentSource"
                    }
                  },
                  {
                    "contains": {
                      "$ref": "#/$defs/LiteratureSource"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "ClassificationRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "document": {
          "$ref": "#/$defs/PreparedDocument"
        }
      },
      "required": [
        "schema_version",
        "document"
      ],
      "additionalProperties": false
    },
    "ExtractionRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "document": {
          "$ref": "#/$defs/PreparedDocument"
        }
      },
      "required": [
        "schema_version",
        "document"
      ],
      "additionalProperties": false
    },
    "DocumentQuestionRequest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "document": {
          "$ref": "#/$defs/PreparedDocument"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "role",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "document",
        "question"
      ],
      "additionalProperties": false
    },
    "LiteratureAnswerRequest": {
      "$ref": "#/$defs/RetrievalRequest"
    },
    "ErrorDetail": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "unsupported_file",
            "unsupported_language",
            "validation_failure",
            "timeout",
            "rate_limit",
            "provider_unavailable",
            "insufficient_evidence",
            "document_unavailable",
            "unauthorized",
            "configuration_required",
            "budget_exceeded",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "$ref": "#/$defs/ErrorDetail"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    },
    "HealthResult": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "service": {
          "type": "string",
          "enum": [
            "rag",
            "classifier",
            "extraction"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "not_ready"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "service",
        "status",
        "mode",
        "version"
      ],
      "additionalProperties": false
    }
  }
}
